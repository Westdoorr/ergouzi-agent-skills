{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aiman-labs/ergouzi-agent-skills/schemas/codex-plugin.schema.json",
  "title": "Codex plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "author", "interface"],
  "properties": {
    "name": { "$ref": "#/$defs/name" },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "homepage": { "type": "string", "pattern": "^https://" },
    "repository": { "type": "string", "pattern": "^https://" },
    "license": { "type": "string", "minLength": 1 },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "skills": { "$ref": "#/$defs/relativePath" },
    "mcpServers": {
      "oneOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "object" }]
    },
    "apps": { "$ref": "#/$defs/relativePath" },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "shortDescription",
        "longDescription",
        "developerName",
        "category",
        "capabilities",
        "defaultPrompt"
      ],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "shortDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "longDescription": { "type": "string", "minLength": 1 },
        "developerName": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "websiteURL": { "type": "string", "pattern": "^https://" },
        "privacyPolicyURL": { "type": "string", "pattern": "^https://" },
        "termsOfServiceURL": { "type": "string", "pattern": "^https://" },
        "defaultPrompt": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          ]
        },
        "brandColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "composerIcon": { "$ref": "#/$defs/relativePath" },
        "logo": { "$ref": "#/$defs/relativePath" },
        "logoDark": { "$ref": "#/$defs/relativePath" },
        "screenshots": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^\\./(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    }
  }
}
